{
  "name": "gymly-functions",
  "description": "Gymly Cloud Functions for scheduled reminders",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test",
    "test:emulator": "firebase emulators:exec --only firestore --project demo-gymly-test 'node --test'"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "node-fetch": "^2.7.0",
    "razorpay": "^2.9.6"
  },
  "private": true,
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-functions-test": "^3.5.0"
  }
}
