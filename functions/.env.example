# Copy to functions/.env and fill in. functions/.env is gitignored — never commit it.

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
VITE_CLEOMITRA_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── GA4 Measurement Protocol (server-side analytics) ──
# GA_API_SECRET: Google Analytics → Admin → Data streams → (the G-6XXNPM9R3Y web
# stream) → Measurement Protocol API secrets → Create. This is NOT the
# measurement ID. Leave blank to disable all server-side analytics.
GA_MEASUREMENT_ID=G-6XXNPM9R3Y
GA_API_SECRET=
# Optional. Changing it re-buckets every gym's pseudo client_id, so leave it be
# once events are flowing.
GA_CLIENT_ID_SALT=gymloop-mp-v1
# Set to "false" to switch server-side analytics off without removing the secret.
GA_ANALYTICS_ENABLED=true
# Testing only. GA_DEBUG=true makes server events visible in GA4 DebugView.
# GA_VALIDATE=true posts to the validation endpoint instead (checks payload
# shape, does NOT record). Leave both false in normal operation.
GA_DEBUG=false
GA_VALIDATE=false
