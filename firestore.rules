rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super Admin (Gravity Studios Co platform control plane) — claim set out-of-band by
    // scripts/setSuperAdmin.js. Grants cross-tenant READ only in Phase 1.
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.super_admin == true;
    }

    // Kiosk devices sign in anonymously — identified by sign_in_provider.
    // Allows reading members and writing attendance sessions without gym_id claims.
    function isKiosk() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Users — same-gym read/write; role and gym_id are server-managed fields
    match /users/{uid} {
      allow read: if request.auth != null
                  && (
                    request.auth.uid == uid
                    ||
                    request.auth.token.gym_id
                      == resource.data.gym_id
                    ||
                    isSuperAdmin()
                    ||
                    isKiosk()
                    ||
                    // Phone Auth linking: newly authenticated member can find their
                    // owner-created doc by matching the phone number claim.
                    request.auth.token.phone_number == resource.data.phone
                  );

      allow create: if request.auth != null;

      allow update: if request.auth != null
                    && (
                      request.auth.uid == uid
                      ||
                      request.auth.token.gym_id
                        == resource.data.gym_id
                    )
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'gym_id']);

      // Allow a newly-linked member to delete their old pre-created doc (random ID).
      // Conditions: phone must match the auth token, and the doc must not already
      // be linked to an auth account (auth_uid field absent = null).
      allow delete: if request.auth != null
                    && request.auth.token.phone_number == resource.data.phone
                    && resource.data.auth_uid == null;
    }

    // Gyms — authenticated read; writes scoped to owner_id (H-3)
    // Stats subcollection — server-only writes; owner/manager read (O-3)
    match /gyms/{gymId}/stats/{document} {
      allow read: if request.auth != null
        && (request.auth.token.gym_id == gymId || isSuperAdmin());
      allow write: if false;
    }
    match /gyms/{gymId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner_id == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.owner_id == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.owner_id == request.auth.uid;
    }

    // Leads — public can create with validated fields only; staff can read/update (L-2)
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'gym_id', 'created_at', 'message'])
        && request.resource.data.name is string && request.resource.data.name.size() < 100
        && request.resource.data.phone is string && request.resource.data.phone.size() < 100;
      allow read, update: if request.auth != null;
    }

    // Phase 3: Workout System
    match /workout_plans/{planId} {
      allow read, write: if request.auth != null;
    }

    match /workout_days/{dayId} {
      allow read, write: if request.auth != null;
    }

    match /workout_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /progress_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    match /soreness_logs/{logId} {
      allow read, write: if request.auth != null;
    }

    // Phase 4: Payments — gym-isolated (H-4); super-admin read for the control plane
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && (request.auth.token.gym_id
           == resource.data.gym_id
           || isSuperAdmin());
      allow create: if request.auth != null
        && request.resource.data.gym_id
           == request.auth.token.gym_id;
      allow update, delete: if request.auth != null
        && resource.data.gym_id
           == request.auth.token.gym_id;
    }

    match /invoice_counter/{gymId} {
      allow read, write: if request.auth != null
        && request.auth.token.gym_id == gymId;
    }

    // Phase 4: Attendance Logs — gym-isolated (H-4)
    match /attendance_logs/{logId} {
      allow read: if request.auth != null
        && request.auth.token.gym_id
           == resource.data.gym_id;
      allow create: if request.auth != null
        && request.resource.data.gym_id
           == request.auth.token.gym_id;
      allow update, delete: if request.auth != null
        && resource.data.gym_id
           == request.auth.token.gym_id;
    }

    // Phase 4: WhatsApp Logs — gym-isolated (H-4)
    match /whatsapp_logs/{logId} {
      allow read: if request.auth != null
        && request.auth.token.gym_id
           == resource.data.gym_id;
      allow create: if request.auth != null
        && request.resource.data.gym_id
           == request.auth.token.gym_id;
      allow update, delete: if request.auth != null
        && resource.data.gym_id
           == request.auth.token.gym_id;
    }

    // Phase 5: Message Retry Queue — gym-isolated (H-4)
    match /message_retry_queue/{docId} {
      allow read: if request.auth != null
        && request.auth.token.gym_id
           == resource.data.gym_id;
      allow create: if request.auth != null
        && request.resource.data.gym_id
           == request.auth.token.gym_id;
      allow update, delete: if request.auth != null
        && resource.data.gym_id
           == request.auth.token.gym_id;
    }

    // Phase 5: Message Logs — gym-isolated (H-4)
    match /message_logs/{logId} {
      allow read: if request.auth != null
        && request.auth.token.gym_id
           == resource.data.gym_id;
      allow create: if request.auth != null
        && request.resource.data.gym_id
           == request.auth.token.gym_id;
      allow update, delete: if request.auth != null
        && resource.data.gym_id
           == request.auth.token.gym_id;
    }

    // Phase 6: Invoices — gym-isolated (H-4)
    match /invoices/{invoiceId} {
      allow read: if request.auth != null
        && request.auth.token.gym_id
           == resource.data.gym_id;
      allow create: if request.auth != null
        && request.resource.data.gym_id
           == request.auth.token.gym_id;
      allow update, delete: if request.auth != null
        && resource.data.gym_id
           == request.auth.token.gym_id;
    }

    // Subscription System
    match /subscriptions/{gymId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.token.role == 'admin'
            || get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_id == request.auth.uid);
    }

    match /billing/{gymId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && (request.auth.token.role == 'admin'
            || get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_id == request.auth.uid);
    }

    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    match /admin_logs/{logId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false;
    }

    // Member Numbering System — gym-isolated (H-4)
    match /numbering_settings/{gymId} {
      allow read, write: if request.auth != null
        && request.auth.token.gym_id == gymId;
    }

    // Serial counters docId is {gymId}_{counterKey}; gymId field stored in doc (H-4)
    // resource may be null on the first-ever read inside a transaction (doc doesn't exist yet),
    // so we allow reads when resource is null but the caller has a valid gym_id claim.
    match /serial_counters/{docId} {
      allow read: if request.auth != null
        && request.auth.token.gym_id != null
        && (resource == null || resource.data.gymId == request.auth.token.gym_id);
      allow create: if request.auth != null
        && request.resource.data.gymId
           == request.auth.token.gym_id;
      allow update, delete: if request.auth != null
        && resource.data.gymId
           == request.auth.token.gym_id;
    }

    // Coupon Activation — owners can read; all writes go through redeemCoupon Cloud Function
    match /used_coupons/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Kiosk Devices — kiosk signs in anonymously; pairing completes without gym_id claim.
    match /kiosk_devices/{deviceId} {
      allow read: if request.auth != null;
      // Allow pairing transition (anonymous kiosk activating itself),
      // device-secret-based updates (lastSeen from paired device),
      // or owner/manager management updates.
      allow update: if (resource.data.status == 'pairing')
                    || request.resource.data.device_secret == resource.data.device_secret
                    || (request.auth != null && request.auth.token.role in ['owner', 'manager']);
      allow create, delete: if request.auth != null
        && request.auth.token.role
           in ['owner', 'manager'];
    }

    // Attendance Sessions — anonymous kiosk writes are allowed (gymId validated in app).
    match /attendance_sessions/{sessionId} {
      allow create: if request.auth != null
        && (request.resource.data.gymId == request.auth.token.gym_id || isKiosk());
      allow update: if request.auth != null
        && (resource.data.gymId == request.auth.token.gym_id || isKiosk());
      allow read: if request.auth != null
        && (request.auth.token.gym_id == resource.data.gymId || isKiosk());
      allow delete: if false;
    }

    // Access Denied Logs — kiosk writes, owners read
    match /access_denied_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if true;
    }

    // Coupons — server-only; never readable or writable by clients
    match /coupons/{code} {
      allow read, write: if false;
    }

    // Recycle bin — owner and manager in same gym can read; all writes server-only
    match /deleted_members/{gymId}/bin/{memberId} {
      allow read: if request.auth != null
        && request.auth.token.gym_id == gymId
        && request.auth.token.role
           in ['owner', 'manager'];
      allow write: if false;
    }

    // Audit log — owner and manager read only; completely server-side writes
    match /audit_logs/{gymId}/events/{eventId} {
      allow read: if request.auth != null
        && request.auth.token.gym_id == gymId
        && request.auth.token.role
           in ['owner', 'manager'];
      allow write: if false;
    }

    // Platform Stats — Super Admin KPI rollup; written only by Cloud Functions (SA-1)
    match /platform_stats/{document} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Gym Summaries — denormalized per-gym plan/status/member counts for the
    // control plane. Super-admin read only (keeps cross-gym data out of the
    // publicly-readable gyms doc); written only by Cloud Functions (SA-3).
    match /gym_summaries/{gymId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Plans — Gymly subscription tiers. Readable by any authed user (owners see
    // their own plan); all writes server-side / Phase 2 admin only (SA-1)
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Broadcasts — platform announcements. Owners may read only ACTIVE ones (for
    // the in-app banner); super-admin reads all for management. Writes go through
    // the admin callables only (SA-4).
    match /broadcasts/{id} {
      allow read: if isSuperAdmin()
        || (request.auth != null && resource.data.active == true);
      allow write: if false;
    }
  }
}
